# Скопіюйте цей файл у .env і заповніть

# Токен від @BotFather
BOT_TOKEN=1234567890:AAH...

# Канал, куди публікувати: @username або числовий id (-100...)
CHANNEL_ID=@my_books_channel

# Telegram ID адміністраторів через кому (свій ID бот покаже у відповідь на /start)
ADMIN_IDS=123456789

# true — кожна новина спершу приходить адмінам із кнопками «Опублікувати / У чергу / Пропустити»
# false — публікується автоматично
MODERATION=false

# Як часто перевіряти джерела (хв) і мінімальний проміжок між постами (хв)
FETCH_INTERVAL_MIN=30
POST_INTERVAL_MIN=20

# Не публікувати вночі (за місцевим часом). Порожньо або off — без тихих годин
QUIET_HOURS=23-8
TIMEZONE=Europe/Kyiv

# Максимум постів на добу (0 — без обмежень)
MAX_POSTS_PER_DAY=0

# Брати лише новини, не старші за N днів
MAX_AGE_DAYS=3

# Скільки нових новин брати з одного джерела за одну перевірку
MAX_NEW_PER_SOURCE=5

# Підпис у кінці кожного поста (необов'язково), напр. @my_books_channel
POST_SIGNATURE=

# Де зберігати базу та список джерел
DB_PATH=data/bookbot.sqlite3
SOURCES_FILE=sources.yaml

LOG_LEVEL=INFO
